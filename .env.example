# Vela refuses to serve any request until both of these are set,
# unless ENVIRONMENT is exactly "development".

# "development" disables Cloudflare Access verification entirely. Anything else —
# including a typo or a missing value — is production and verifies every
# request. Never deploy with "development".
ENVIRONMENT=production

# They describe the Cloudflare Access application in front of Vela.

# Your Cloudflare One team domain: https://<team-name>.cloudflareaccess.com
VELA_TEAM_DOMAIN=

# The Application Audience (AUD) tag of the Access application for Vela.
VELA_POLICY_AUD=

# Port the Node server listens on.
PORT=3000
